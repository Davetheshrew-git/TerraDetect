# PORT: Server port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where the application is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# VITE_GOOGLE_MAPS_API_KEY: Optional custom Google Maps JavaScript API Key
# If omitted, TerraDetect runs on its high-resolution Field GIS satellite & LiDAR engine
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_MAP_ID: Optional Vector Map ID
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"
