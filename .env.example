# GEMINI_API_KEY: Required for Google Gemini AI artifact identification & valuation.
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where the application is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# VITE_GOOGLE_MAPS_API_KEY: Optional custom Google Maps API Key
# If omitted, the app falls back automatically to high-resolution Field GIS satellite & LiDAR mapping
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# VITE_GOOGLE_MAPS_MAP_ID: Optional Vector Map ID (supports AdvancedMarkerElement)
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"
